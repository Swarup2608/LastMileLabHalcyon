NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins (the web app). Writes from any other Origin are refused.
CORS_ORIGINS=http://localhost:3000

# Required. The auth tables come from db/init/02_auth.sql (applied on first container start).
DATABASE_URL=postgres://<username>:<password>@localhost:5433/halcyon
DATABASE_POOL_MAX=10

# Required, at least 32 characters: signs the access and refresh tokens. Generate with `openssl rand -base64 48`
JWT_SECRET=<secret>
# Token lifetimes in seconds (defaults: 15 minutes / 7 days)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cookies are Secure by default; set to false only for Safari on plain http://localhost
COOKIE_SECURE=true
# lax when web and API share a site (localhost:3000 + localhost:4000). When they are on different sites
# (e.g. two *.azurewebsites.net apps) use none, which requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# Optional: share cookies across subdomains, e.g. .halcyon.example
COOKIE_DOMAIN=
# Number of proxies in front of the API; drives the client IP the login rate limiter counts.
#   0 locally. On Azure App Service with the browser going through the web app's /api rewrite, 2: the web app's front
#   end + the API's front end each add a hop (Next.js passes X-Forwarded-For through without adding its own).
#   1 only if browsers call the API directly. Too low and every user shares the web server's IP; too high and the IP
#   can be spoofed (the per-account limit still applies). Check auth_sessions.ip shows real client IPs after deploy.
TRUST_PROXY=0

# Optional: Redis for the login rate limiter, so its counters are shared by every instance and survive restarts.
# Upstash: copy the TLS connection string, rediss://default:<token>@<host>.upstash.io:6379
# Leave empty to keep the counters in memory (restarting the API then resets them).
REDIS_URL=

# Retention, applied at startup and every 6 hours: session rows are deleted this many days after they expire, audit
# rows after this many days (0 keeps the audit log forever). Defaults: 30 / 365.
SESSION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# First admin: not set here. Run `npm run admin:create -- you@example.com "Your Name"` once; it prints a generated
# password. That admin adds contributors, other admins and client logins from Users in the portal.

# Optional Gmail inbox poller: copies new inbox mail (headers + snippet) into inbound_emails (db/init/05_inbound_emails.sql),
# readable by staff at GET /api/emails. Set all three or none; with none the poller is off.
# OAuth client from Google Cloud Console; refresh token issued for the mailbox with scope gmail.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Seconds between polls (default 60)
EMAIL_POLL_INTERVAL_SECONDS=60

# Optional Foundry agent: after each poll, every email with read_by_ai = false is sent to it and its reply stored in
# inbound_emails.ai_result. Staff can also trigger it with POST /api/emails/analyze. Set both or neither.
# Auth is FOUNDRY_API_KEY when set (the Foundry resource's key), otherwise DefaultAzureCredential
# (`az login` locally, managed identity on Azure).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=
FOUNDRY_API_KEY=

# Optional second Foundry agent (same project and key) that drafts customer messages, e.g. the out-of-stock notice
# proposing a new delivery date. The API sends only the order's details (customer, order ref, items out of stock,
# warehouse, original and new delivery dates, staff note); the agent's own instructions hold the email-writing rules
# and should have it reply with the email text only. Without it, those drafts come from a built-in template.
FOUNDRY_DRAFT_AGENT_NAME=

# Optional third Foundry agent (same project and key): the carrier recommender. Once the same-day cutoff (set by an
# admin, default 08:00) has passed, the day's same-day orders are final, so the API sends them as JSON
# ({ orders: [{ orderId, warehouseName, destination, region, shippingPriority }], carriers: [{ carrierName,
# preferredSupplier, regionalLateDeliveryRates, averageShippingPrice, ... }] }) with the carrier figures from the
# carrier_performance table (db/init/09_carrier_performance.sql). The agent's own instructions hold the report format
# and scoring rules and should have it reply with the plain-text report. Contributors and admins see the report on the
# Carriers page and can run it again. Without it there's no carrier plan.
FOUNDRY_CARRIER_AGENT_NAME=

# Optional fourth Foundry agent (same project and key): the allocation agent behind Inventory's Rebalance. Staff pick a
# product's Rebalance (or Rebalance all) and the API sends the products as JSON ({ settings, products: [{ product (the
# SKU), totalAvailability, warehouses: [{ id, orders, outOfStockPercentage, presentValue, availableStock, reservedStock,
# safetyBuffer, incomingStock, distanceToCustomer, stockoutsAtNearest }], routes: [{ from, to, distance, cost,
# deliveryTime }] }] }). Over the last 30 days: orders = cartons the warehouse should have served (routed there, plus
# missed there as the order's nearest warehouse, from the stock-out log in db/init/11_stockout_events.sql);
# outOfStockPercentage = the share it missed; safetyBuffer = the reorder point. Rebalance all goes in batches of 10. The agent's own instructions hold the decision rules and should have it reply with JSON in the
# output schema ({ products: [{ decision, recommendedTransfers, ... }], summary, contributorNotes }). Staff edit the
# suggestion and apply it, which saves the transfers (see STOCK_TRANSFER_DELAY_DAYS). Without the agent the Rebalance
# buttons explain it isn't set up.
FOUNDRY_ALLOCATION_IQ_AGENT_NAME=
# When staff apply a rebalance on Inventory, the transfers are saved (db/init/12_stock_transfers.sql) and the cartons
# leave the source warehouse at once. They reach the destination this many days later (0: at once), which is when
# Resolve's warehouse choice and auto-routing see them there. Until then they're in transit, shown on Inventory and sent
# to the allocation agent as incomingStock. Default 0 (immediate); 1 lands them the next day.
STOCK_TRANSFER_DELAY_DAYS=0

# Optional SMTP server (sent with nodemailer) for the portal's "Send via mail" option on New order: the order is emailed
# to ORDER_INBOX, which should be the mailbox the Gmail poller above reads, so it arrives like any emailed order. Set
# SMTP_HOST and ORDER_INBOX together, or neither to hide the option. Gmail: smtp.gmail.com, 465, SMTP_SECURE=true, and
# an app password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address; defaults to SMTP_USER. The client is set as Reply-To.
MAIL_FROM=
ORDER_INBOX=

# Demo accounts (default true). false: none on the sign-in page, they can't sign in, and none can be turned on.
DEMO_MODE=true

{
  "name": "halcyon-api",
  "version": "1.0.0",
  "description": "This is the backend repo for the halcyon-api",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:tables": "tsx src/db/tables.ts",
    "admin:create": "tsx src/db/create-admin.ts",
    "sim:week": "tsx src/sim/week.ts",
    "bench:scale": "tsx src/sim/scale.ts"
  },
  "dependencies": {
    "@azure/ai-projects": "^2.9.0",
    "@azure/identity": "4.14.1",
    "@googleapis/gmail": "^22.0.2",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^188.0.0",
    "helmet": "^8.3.0",
    "ioredis": "5.11.1",
    "jose": "^6.2.13",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
